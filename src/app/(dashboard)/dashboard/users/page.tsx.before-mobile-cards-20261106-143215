"use client";

import EmployeeModuleTabs from "@/components/users/EmployeeModuleTabs";

import EmployeeRoleModal from "@/components/users/EmployeeRoleModal";

import EmployeeStatusModal from "@/components/users/EmployeeStatusModal";

import EditEmployeeModal from "@/components/users/EditEmployeeModal";
import { useDashboardUser } from "@/components/layout/DashboardShell";

import RegisterEmployeeModal from "@/components/users/RegisterEmployeeModal";


import { useCallback, useEffect, useState } from "react";
import {
  Users,
  Pencil,
  UserRoundX,
  UserRoundCheck,
  Search,
  RefreshCw,
  ShieldCheck,
  ChevronLeft,
  ChevronRight,
  UserRound,
} from "lucide-react";

type Employee = {
  id: number;
  name: string;
  email: string;
  status: string;
  roles?: Array<string | { name: string }>;
};

type PageResult = {
  users?: {
    data?: Employee[];
    current_page?: number;
    last_page?: number;
    total?: number;
  } | Employee[];
  data?: Employee[];
  current_page?: number;
  last_page?: number;
  total?: number;
  message?: string;
};

function normalizeResult(payload: PageResult) {
  const nested =
    payload.users &&
    !Array.isArray(payload.users) &&
    typeof payload.users === "object"
      ? payload.users
      : null;

  const employees = Array.isArray(payload.users)
    ? payload.users
    : Array.isArray(nested?.data)
      ? nested.data
      : Array.isArray(payload.data)
        ? payload.data
        : [];

  return {
    employees,
    total: nested?.total ?? payload.total ?? employees.length,
    currentPage: nested?.current_page ?? payload.current_page ?? 1,
    lastPage: nested?.last_page ?? payload.last_page ?? 1,
  };
}

function roleNames(roles: Employee["roles"]) {
  if (!Array.isArray(roles)) return [];

  return roles.map((role) =>
    typeof role === "string" ? role : role.name
  );
}

export default function EmployeesPage() {
  const [roleEmployee, setRoleEmployee] =
    useState<Employee | null>(null);

  const [statusEmployee, setStatusEmployee] =
    useState<Employee | null>(null);

  const currentUser = useDashboardUser();

  const canEditEmployees =
    currentUser.roles.includes("system_admin") ||
    currentUser.permissions.includes("users.update");

  const [selectedEmployee, setSelectedEmployee] =
    useState<Employee | null>(null);

  const [registrationOpen, setRegistrationOpen] = useState(false);
  const [reloadVersion, setReloadVersion] = useState(0);

  const [employees, setEmployees] = useState<Employee[]>([]);
  const [search, setSearch] = useState("");
  const [activeSearch, setActiveSearch] = useState("");
  const [page, setPage] = useState(1);
  const [lastPage, setLastPage] = useState(1);
  const [total, setTotal] = useState(0);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");

  const loadEmployees = useCallback(async (
    term: string,
    requestedPage: number,
    signal: AbortSignal
  ) => {
    try {
      const params = new URLSearchParams({
        page: String(requestedPage),
      });

      if (term.trim()) {
        params.set("search", term.trim());
      }

      const response = await fetch(
        `/api/backend/users?${params.toString()}`,
        {
          credentials: "same-origin",
          cache: "no-store",
          signal,
        }
      );

      const payload = (await response.json()) as PageResult;

      if (!response.ok) {
        throw new Error(
          response.status === 403
            ? "You do not have permission to view employees."
            : response.status === 401
              ? "Your session has expired. Please log in again."
              : payload.message || "Unable to load employees."
        );
      }

      if (!Array.isArray(payload.users) &&
          !Array.isArray(payload.data) &&
          !(
            payload.users &&
            !Array.isArray(payload.users) &&
            Array.isArray(payload.users.data)
          )) {
        throw new Error(
          "Unexpected employee API response format."
        );
      }

      const normalized = normalizeResult(payload);

      setEmployees(normalized.employees);
      setTotal(normalized.total);
      setLastPage(normalized.lastPage);
    } catch (err) {
      if (signal.aborted) return;

      setEmployees([]);
      setError(
        err instanceof Error ? err.message : "Request failed."
      );
    } finally {
      if (!signal.aborted) {
        setLoading(false);
      }
    }
  }, []);

  useEffect(() => {
    const controller = new AbortController();

    // Start the asynchronous request after the effect setup.
    // This avoids synchronous state updates during the effect.
    const task = Promise.resolve().then(() => {
      if (!controller.signal.aborted) {
        return loadEmployees(
          activeSearch,
          page,
          controller.signal
        );
      }
    });

    void task;

    return () => controller.abort();
  }, [activeSearch, page, loadEmployees, reloadVersion]);

  function submitSearch(event: React.FormEvent<HTMLFormElement>) {
    event.preventDefault();
    setPage(1);
    setActiveSearch(search);
  }

  function refresh() {
    setPage(1);
    setActiveSearch(search);
  }

  return (
    <>
    <main className="min-h-screen bg-[#f5f7fc] px-5 py-7 text-slate-800 md:px-8">
      <EmployeeModuleTabs />
      <div className="mx-auto max-w-7xl">
        <div className="mb-7 flex flex-wrap items-center justify-between gap-4">
          <div>
            <p className="text-xs font-bold uppercase tracking-widest text-indigo-500">
              Module 1 / User Management
            </p>

            <h1 className="mt-2 text-2xl font-bold">
              Employee Management
            </h1>

            <p className="mt-2 text-sm text-slate-500">
              View and search employees registered in KFMS.
            </p>
          </div>

          <div className="flex flex-wrap items-center gap-3">
            <span className="rounded-xl bg-indigo-50 px-4 py-3 text-sm font-semibold text-indigo-600">
              {total} registered employees
            </span>

            <button
              type="button"
              onClick={() => setRegistrationOpen(true)}
              className="rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-indigo-700"
            >
              + Register Employee
            </button>
          </div>
        </div>

        <div className="mb-6 grid gap-4 sm:grid-cols-2">
          <div className="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <div className="flex items-center gap-3">
              <div className="rounded-xl bg-indigo-50 p-3 text-indigo-600">
                <Users size={22} />
              </div>

              <div>
                <p className="text-sm text-slate-500">
                  Total Employees
                </p>
                <p className="text-2xl font-bold">{total}</p>
              </div>
            </div>
          </div>

          <div className="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <div className="flex items-center gap-3">
              <div className="rounded-xl bg-green-50 p-3 text-green-600">
                <ShieldCheck size={22} />
              </div>

              <div>
                <p className="text-sm text-slate-500">
                  Account Administration
                </p>
                <p className="mt-1 text-sm font-semibold">
                  Role-based access
                </p>
              </div>
            </div>
          </div>
        </div>

        <section className="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
          <div className="flex flex-wrap items-center justify-between gap-4 border-b border-slate-100 p-5">
            <div>
              <h2 className="font-bold">Employee Directory</h2>
              <p className="mt-1 text-xs text-slate-400">
                Records retrieved from the Laravel API
              </p>
            </div>

            <form
              onSubmit={submitSearch}
              className="flex w-full flex-wrap gap-2 sm:w-auto"
            >
              <div className="relative flex-1 sm:w-64">
                <Search
                  size={17}
                  className="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"
                />
                <input
                  aria-label="Search employees"
                  value={search}
                  onChange={(event) => setSearch(event.target.value)}
                  placeholder="Search employees..."
                  maxLength={150}
                  className="w-full rounded-xl border border-slate-200 py-2.5 pl-10 pr-3 text-sm outline-none focus:border-indigo-400"
                />
              </div>

              <button
                type="submit"
                className="rounded-xl bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-indigo-700"
              >
                Search
              </button>

              <button
                type="button"
                aria-label="Refresh employee list"
                onClick={refresh}
                className="rounded-xl border border-slate-200 p-2.5 text-slate-500 hover:bg-slate-50"
              >
                <RefreshCw size={18} />
              </button>
            </form>
          </div>

          {error && (
            <div
              role="alert"
              className="m-5 rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-700"
            >
              {error}
            </div>
          )}

          {loading ? (
            <div className="p-12 text-center text-sm text-slate-500">
              Loading employees...
            </div>
          ) : employees.length === 0 ? (
            <div className="p-12 text-center">
              <Users className="mx-auto text-slate-300" size={35} />
              <p className="mt-3 text-sm text-slate-500">
                {error ? "Unable to display employees." : "No employees found."}
              </p>
            </div>
          ) : (
            <div className="w-full max-w-full overflow-x-auto overscroll-x-contain">
              <table className="w-full min-w-[650px] text-left text-sm">
                <thead className="bg-[#f8faff] text-xs uppercase tracking-wide text-slate-400">
                  <tr>
                    <th className="px-6 py-4">Employee</th>
                    <th className="px-6 py-4">Role</th>
                    <th className="px-6 py-4">Status</th>
                    <th className="px-6 py-4">ID</th>
                    <th className="px-6 py-4">Actions</th>
                  </tr>
                </thead>

                <tbody className="divide-y divide-slate-100">
                  {employees.map((employee) => (
                    <tr
                      key={employee.id}
                      className="hover:bg-slate-50"
                    >
                      <td className="px-6 py-4">
                        <div className="flex items-center gap-3">
                          <div className="rounded-full bg-indigo-50 p-2 text-indigo-600">
                            <UserRound size={19} />
                          </div>
                          <div>
                            <div className="font-semibold">
                              {employee.name}
                            </div>
                            <div className="break-all text-xs text-slate-400">
                              {employee.email}
                            </div>
                          </div>
                        </div>
                      </td>

                      <td className="px-6 py-4">
                        {roleNames(employee.roles)
                          .map((role) => role.replaceAll("_", " "))
                          .join(", ") || "No role"}
                      </td>

                      <td className="px-6 py-4">
                        <span
                          className={`rounded-full px-3 py-1 text-xs font-semibold capitalize ${
                            employee.status === "active"
                              ? "bg-green-50 text-green-700"
                              : "bg-amber-50 text-amber-700"
                          }`}
                        >
                          {employee.status}
                        </span>
                      </td>

                      <td className="px-6 py-4 text-slate-500">
                        #{employee.id}
                      </td>

                      <td className="px-6 py-4">
                        <div className="flex flex-wrap items-center gap-2">
                          {canEditEmployees && (
                            <button
                              type="button"
                              onClick={() => setSelectedEmployee(employee)}
                              aria-label={`Edit ${employee.name}`}
                              title="Edit employee"
                              className="rounded-lg border border-indigo-200 bg-indigo-50 px-4 py-2 text-xs font-semibold text-indigo-700 transition hover:bg-indigo-100"
                            >
                              <Pencil size={17} />
                            </button>
                          )}

                          {canEditEmployees &&
                            employee.id !== currentUser.id && (
                              <button
                                type="button"
                                onClick={() => setStatusEmployee(employee)}
                                aria-label={`${employee.status === "active" ? "Suspend" : "Reactivate"} ${employee.name}`}
                                title={employee.status === "active" ? "Suspend employee" : "Reactivate employee"}
                                className={`rounded-lg border px-3 py-2 text-xs font-semibold ${
                                  employee.status === "active"
                                    ? "border-amber-200 bg-amber-50 text-amber-700"
                                    : "border-green-200 bg-green-50 text-green-700"
                                }`}
                              >
                                {employee.status === "active"
                                  ? <UserRoundX size={17} />
                                  : <UserRoundCheck size={17} />}
                              </button>
                            )}

                          {currentUser.roles.includes("system_admin") &&
                            employee.id !== currentUser.id && (
                              <button
                                type="button"
                                onClick={() => setRoleEmployee(employee)}
                                aria-label={`Manage role for ${employee.name}`}
                                title="Manage employee role"
                                className="rounded-lg border border-violet-200 bg-violet-50 px-3 py-2 text-xs font-semibold text-violet-700 transition hover:bg-violet-100"
                              >
                                <ShieldCheck size={17} />
                              </button>
                            )}

                          {!canEditEmployees && (
                            <span className="break-all text-xs text-slate-400">
                              View only
                            </span>
                          )}
                        </div>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}

          <div className="flex items-center justify-between border-t border-slate-100 px-5 py-4">
            <span className="text-xs text-slate-500">
              Page {page} of {lastPage}
            </span>

            <div className="flex gap-2">
              <button
                type="button"
                disabled={loading || page <= 1}
                onClick={() => setPage((value) => value - 1)}
                className="rounded-lg border border-slate-200 p-2 disabled:opacity-40"
                aria-label="Previous page"
              >
                <ChevronLeft size={17} />
              </button>
              <button
                type="button"
                disabled={loading || page >= lastPage}
                onClick={() => setPage((value) => value + 1)}
                className="rounded-lg border border-slate-200 p-2 disabled:opacity-40"
                aria-label="Next page"
              >
                <ChevronRight size={17} />
              </button>
            </div>
          </div>
        </section>
      </div>
    </main>
  
    {selectedEmployee && (
      <EditEmployeeModal
        key={selectedEmployee.id}
        employee={selectedEmployee}
        onClose={() => setSelectedEmployee(null)}
        onSaved={() => {
          setSelectedEmployee(null);
          setReloadVersion((value) => value + 1);
        }}
      />
    )}

    {statusEmployee && (
      <EmployeeStatusModal
        employee={statusEmployee}
        onClose={() => setStatusEmployee(null)}
        onSaved={() => {
          setStatusEmployee(null);
          setReloadVersion((value) => value + 1);
        }}
      />
    )}

    {roleEmployee && (
      <EmployeeRoleModal
        employee={roleEmployee}
        onClose={() => setRoleEmployee(null)}
        onSaved={() => {
          setRoleEmployee(null);
          setReloadVersion((value) => value + 1);
        }}
      />
    )}

    <RegisterEmployeeModal
      open={registrationOpen}
      onClose={() => setRegistrationOpen(false)}
      onCreated={() => {
        setPage(1);
        setReloadVersion((value) => value + 1);
      }}
    />
    </>
  );
}
