"use client";

import EmployeeModuleTabs from "@/components/users/EmployeeModuleTabs";

import Link from "next/link";
import {
  ShieldCheck,
  Users,
  KeyRound,
  ArrowRight,
  CheckCircle2,
} from "lucide-react";

import {
  useDashboardUser,
} from "@/components/layout/DashboardShell";

const roleDescriptions: Record<string, string> = {
  system_admin:
    "System administration and access management.",
  fleet_admin:
    "Fleet operations and administrative responsibilities.",
  management:
    "Management and oversight responsibilities.",
  employee:
    "Access to authorized employee services.",
};

function displayName(value: string) {
  return value
    .replaceAll("_", " ")
    .replaceAll(".", " · ")
    .replace(/\\b\\w/g, (letter) => letter.toUpperCase());
}

export default function RolesPage() {
  const user = useDashboardUser();

  const isAdmin = user.roles.includes("system_admin");

  const roles = [...user.roles];
  const permissions = [...user.permissions].sort();

  return (
    <main className="mx-auto max-w-6xl p-5 md:p-8">
      <EmployeeModuleTabs />
      <div className="mb-7">
        <p className="text-xs font-bold uppercase tracking-widest text-indigo-500">
          Administration / Access Control
        </p>

        <h1 className="mt-2 text-2xl font-bold text-slate-800">
          Roles & Permissions
        </h1>

        <p className="mt-2 text-sm text-slate-500">
          Understand your access to Kinvest Fleet Management.
        </p>
      </div>

      <div className="mb-6 grid gap-4 sm:grid-cols-2">
        <div className="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
          <div className="flex items-center gap-3">
            <ShieldCheck className="text-indigo-600" size={25} />
            <span className="text-sm text-slate-500">
              Your Assigned Roles
            </span>
          </div>
          <p className="mt-4 text-3xl font-bold text-slate-800">
            {roles.length}
          </p>
        </div>

        <div className="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
          <div className="flex items-center gap-3">
            <KeyRound className="text-violet-600" size={25} />
            <span className="text-sm text-slate-500">
              Your Permissions
            </span>
          </div>
          <p className="mt-4 text-3xl font-bold text-slate-800">
            {permissions.length}
          </p>
        </div>
      </div>

      <div className="grid gap-6 lg:grid-cols-2">
        <section className="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
          <h2 className="mb-2 text-lg font-bold text-slate-800">
            Assigned Roles
          </h2>
          <p className="mb-5 text-sm text-slate-500">
            Roles currently assigned to your account.
          </p>

          {roles.length === 0 ? (
            <p className="text-sm text-slate-500">
              No roles assigned.
            </p>
          ) : (
            <div className="space-y-3">
              {roles.map((role) => (
                <div
                  key={role}
                  className="rounded-xl border border-indigo-100 bg-indigo-50 p-4"
                >
                  <div className="flex items-center gap-2">
                    <CheckCircle2
                      size={18}
                      className="text-indigo-600"
                    />
                    <strong className="text-sm text-indigo-900">
                      {displayName(role)}
                    </strong>
                  </div>
                  <p className="mt-2 text-xs leading-5 text-indigo-800">
                    {roleDescriptions[role] ||
                      "Access determined by assigned permissions."}
                  </p>
                </div>
              ))}
            </div>
          )}
        </section>

        <section className="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
          <h2 className="mb-2 text-lg font-bold text-slate-800">
            Your Permissions
          </h2>
          <p className="mb-5 text-sm text-slate-500">
            Permissions returned by your authenticated account.
          </p>

          {permissions.length === 0 ? (
            <p className="text-sm text-slate-500">
              No permissions assigned.
            </p>
          ) : (
            <div className="max-h-[440px] space-y-2 overflow-y-auto pr-2">
              {permissions.map((permission) => (
                <div
                  key={permission}
                  className="flex items-center gap-3 rounded-lg bg-slate-50 px-4 py-3"
                >
                  <CheckCircle2
                    size={16}
                    className="shrink-0 text-green-600"
                  />
                  <span className="text-sm text-slate-700">
                    {displayName(permission)}
                  </span>
                </div>
              ))}
            </div>
          )}
        </section>
      </div>

      {isAdmin && (
        <section className="mt-6 rounded-2xl border border-indigo-100 bg-indigo-50 p-6">
          <div className="flex items-start gap-3">
            <Users size={24} className="text-indigo-600" />

            <div className="flex-1">
              <h2 className="font-bold text-indigo-900">
                Manage Employee Roles
              </h2>
              <p className="mt-2 text-sm leading-6 text-indigo-800">
                To assign or change an employee role, open
                Employee Management and use Manage Role
                beside the employee.
              </p>

              <Link
                href="/dashboard/users"
                className="mt-4 inline-flex items-center gap-2 rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white hover:bg-indigo-700"
              >
                Open Employee Management
                <ArrowRight size={17} />
              </Link>
            </div>
          </div>
        </section>
      )}
    </main>
  );
}
