function NavigationSection({
  title,
  items,
  onNavigate,
}: {
  title: string;
  items: NavigationItem[];
  onNavigate: () => void;
}) {
  return (
    <section className="mb-7">
      <h3 className="mb-3 px-5 text-[11px] font-bold uppercase tracking-[0.18em] text-slate-400">
        {title}
      </h3>

      <div className="space-y-1 px-3">
        {items.map((item) => {
          const Icon = item.icon;

          if (!item.available) {
            return (
              <div
                key={item.href}
                title="This page will be connected in a later step"
                className="flex items-center gap-3 rounded-xl px-4 py-3 text-sm text-slate-400"
              >
                <Icon size={18} strokeWidth={1.9} />

                <span className="flex-1">{item.label}</span>

                <LockKeyhole
                  size={13}
                  className="opacity-50"
                />
              </div>
            );
          }

          return (
            <Link
              key={item.href}
              href={item.href}
              onClick={onNavigate}
              className="flex items-center gap-3 rounded-xl bg-indigo-50 px-4 py-3 text-sm font-semibold text-indigo-600"
            >
              <span className="rounded-lg bg-indigo-600 p-1.5 text-white">
                <Icon size={16} />
              </span>

              <span className="flex-1">{item.label}</span>
            </Link>
          );
        })}
      </div>
    </section>
  );
}

export function Initials({ name }: { name: string }) {
  const initials = name
    .trim()
    .split(/\s+/)
    .slice(0, 2)
    .map((part) => part.charAt(0))
    .join("")
    .toUpperCase();

  return (
    <span className="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-indigo-100 text-sm font-bold text-indigo-600">
      {initials || "U"}
    </span>
  );
}

const DashboardUserContext =
  createContext<AuthUser | null>(null);

export function useDashboardUser(): AuthUser {
  const user = useContext(DashboardUserContext);

  if (!user) {
    throw new Error(
      "Dashboard user context is unavailable."
    );
  }

  return user;
}

export default function DashboardShell({
  user,
  children,
}: {
  user: AuthUser;
  children: ReactNode;
}) {
  const router = useRouter();

  const [mobileOpen, setMobileOpen] = useState(false);
  const [loggingOut, setLoggingOut] = useState(false);

  async function logout() {
    if (loggingOut) return;

    setLoggingOut(true);

    try {
      const response = await fetch("/api/auth/logout", {
        method: "POST",
        credentials: "same-origin",
        headers: {
          "Content-Type": "application/json",
        },
      });

      if (!response.ok) {
        throw new Error("Logout request failed.");
      }

      router.replace("/login");
      router.refresh();
    } catch {
      setLoggingOut(false);
      window.alert(
        "Unable to finish signing out. Please try again."
      );
    }
  }

  const role = user.roles
    .map((r) => r.replaceAll("_", " "))
    .join(", ");

  const sidebar = (
    <div className="flex h-full flex-col">
      <div className="flex h-21 items-center gap-3 border-b border-slate-200 px-5">
        <div className="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-indigo-600 font-extrabold text-white shadow-md shadow-indigo-200">
          K
        </div>

        <div className="min-w-0 flex-1">
          <div className="text-base font-extrabold tracking-wide text-indigo-600">
            KINVEST
          </div>

          <div className="text-[10px] font-semibold uppercase tracking-wider text-slate-400">
            Fleet Management
          </div>
        </div>

        <button
          type="button"
          aria-label="Close navigation"
          onClick={() => setMobileOpen(false)}
          className="rounded-lg p-2 text-slate-500 lg:hidden"
        >
          <X size={20} />
        </button>
      </div>

      <nav className="flex-1 overflow-y-auto py-7">
        <NavigationSection
          title="Main Menu"
          items={primaryNavigation}
          onNavigate={() => setMobileOpen(false)}
        />

        <NavigationSection
          title="Fleet Operations"
          items={fleetNavigation}
          onNavigate={() => setMobileOpen(false)}
        />

        <NavigationSection
          title="Account"
          items={settingsNavigation}
          onNavigate={() => setMobileOpen(false)}
        />

        <div className="px-3">
          <div className="flex items-center gap-3 rounded-xl px-4 py-3 text-sm text-slate-400">
            <CircleHelp size={18} />
            Help & Support
          </div>
        </div>
      </nav>

      <div className="border-t border-slate-200 p-4">
        <div className="rounded-2xl border border-slate-200 bg-white p-3 shadow-sm">
          <div className="flex items-center gap-3">
            <Initials name={user.name} />

            <div className="min-w-0">
              <p className="truncate text-sm font-bold text-slate-800">
                {user.name}
              </p>

              <p className="truncate text-xs capitalize text-slate-400">
                {role || "User"}
              </p>
            </div>
          </div>

          <button
            type="button"
            onClick={logout}
            disabled={loggingOut}
            className="mt-3 flex w-full items-center justify-center gap-2 rounded-lg border border-slate-200 bg-slate-50 px-3 py-2.5 text-sm font-semibold text-slate-600 transition hover:border-indigo-200 hover:text-indigo-600 disabled:opacity-50"
          >
            <LogOut size={16} />

            {loggingOut ? "Signing out..." : "Logout"}
          </button>
        </div>
      </div>
    </div>
  );

  return (
    <DashboardUserContext.Provider value={user}>
    <div className="min-h-screen bg-[#f5f7fc] text-slate-800">
      {mobileOpen && (
        <button
          type="button"
          aria-label="Close navigation overlay"
          onClick={() => setMobileOpen(false)}
          className="fixed inset-0 z-40 bg-slate-950/40 lg:hidden"
        />
      )}

      <aside
        className={`fixed inset-y-0 left-0 z-50 w-[270px] transform border-r border-slate-200 bg-[#f8f9fe] transition-transform duration-200 lg:translate-x-0 ${
          mobileOpen ? "translate-x-0" : "-translate-x-full"
        }`}
      >
        {sidebar}
      </aside>

      <div className="min-w-0 lg:pl-[270px]">
        <header className="sticky top-0 z-30 flex h-20 items-center justify-between border-b border-slate-200 bg-white px-5 md:px-8">
          <div className="flex items-center gap-4">
            <button
              type="button"
              aria-label="Open navigation"
              onClick={() => setMobileOpen(true)}
              className="rounded-xl border border-slate-200 p-2.5 text-slate-600 lg:hidden"
            >
              <Menu size={21} />
            </button>

            <div>
              <h1 className="text-lg font-bold text-slate-800 md:text-xl">
                Dashboard
              </h1>

              <p className="hidden text-xs text-slate-400 sm:block">
                Kinvest Fleet Management System
              </p>
            </div>
          </div>

          <div className="flex items-center gap-3 md:gap-5">
            <span className="hidden rounded-full bg-green-50 px-3 py-1.5 text-xs font-semibold text-green-700 sm:inline-flex">
              <CircleCheck size={14} className="mr-1.5" />
              Active account
            </span>

            <div
              title="Notifications will be available in a later module"
              className="rounded-xl border border-slate-200 p-2.5 text-slate-400"
            >
              <Bell size={19} />
            </div>

            <div className="flex items-center gap-2 border-l border-slate-200 pl-3">
              <Initials name={user.name} />

              <div className="hidden max-w-40 sm:block">
                <p className="truncate text-sm font-semibold">
                  {user.name}
                </p>

                <p className="truncate text-xs capitalize text-slate-400">
                  {role || "User"}
                </p>
              </div>
            </div>
          </div>
        </header>

        {children}
      </div>
    </div>
    </DashboardUserContext.Provider>
  );
}
