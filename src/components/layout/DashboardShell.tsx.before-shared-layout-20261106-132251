                      </div>
                    );
                  })}
                </div>
              </section>

              <section className="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm md:p-6">
                <h3 className="font-bold">Upcoming Fleet Modules</h3>

                <p className="mt-1 text-xs text-slate-400">
                  These features will appear as their backend and frontend modules are integrated.
                </p>

                <div className="mt-5 space-y-3">
                  {[
                    { name: "Department Management", icon: Building2 },
                    { name: "Vehicle Management", icon: CarFront },
                    { name: "Vehicle Bookings", icon: CalendarDays },
                    { name: "Trips & Digital Logbook", icon: Route },
                    { name: "Maintenance Management", icon: Wrench },
                  ].map((item) => {
                    const Icon = item.icon;

                    return (
