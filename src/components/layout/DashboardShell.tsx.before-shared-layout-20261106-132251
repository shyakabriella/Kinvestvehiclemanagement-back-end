                    <div className="flex justify-between gap-3 text-xs">
                      <span className="text-slate-500">Status</span>
                      <span className="font-semibold capitalize text-green-600">
                        {user.status}
                      </span>
                    </div>

                    <div className="flex justify-between gap-3 text-xs">
                      <span className="text-slate-500">Roles</span>
                      <span className="text-right font-semibold capitalize">
                        {role || "None"}
                      </span>
                    </div>
                  </div>
                </div>
              </section>

              <section className="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                <h3 className="font-bold">Access Permissions</h3>

                <p className="mt-1 text-xs text-slate-400">
                  Permissions granted to your account
                </p>

                <div className="mt-5 max-h-72 space-y-2 overflow-auto">
                  {user.permissions.length ? (
                    user.permissions.map((permission) => (
                      <div
                        key={permission}
                        className="flex items-center gap-2 rounded-lg bg-slate-50 px-3 py-2.5"
                      >
                        <CircleCheck
                          size={15}
                          className="shrink-0 text-green-500"
                        />

                        <span className="break-all text-xs text-slate-600">
                          {permission}
                        </span>
                      </div>
                    ))
                  ) : (
                    <p className="text-sm text-slate-400">
                      No permissions assigned.
                    </p>
                  )}
                </div>
              </section>

              <section className="rounded-2xl border border-indigo-100 bg-indigo-50 p-5">
                <h3 className="font-bold text-indigo-900">
                  System Information
                </h3>

                <p className="mt-2 text-sm leading-6 text-indigo-800/75">
                  This dashboard is connected to Laravel
                  authentication. Fleet statistics will be
                  available when their modules are implemented.
                </p>
              </section>
            </aside>
          </div>
        </main>
      </div>
    </div>
  );
}
